SERVICE_NAME=crm
NODE_ENV=development
PORT=5184
DATABASE_URL=postgres://crm:dev@localhost:5442/crm
REDIS_URL=redis://localhost:6389
LOG_LEVEL=info
# Who is signed in. "dev" signs every request in as DEV_USER_ID and is refused in production.
# "jwt" verifies a bearer token with JWT_SECRET. Ensemble's own sign-in is another provider behind the same interface.
AUTH_PROVIDER=dev
DEV_USER_ID=usr_maya
