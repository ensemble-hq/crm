SERVICE_NAME=crm
NODE_ENV=development
PORT=5184
DATABASE_URL=postgres://crm:dev@localhost:5442/crm
REDIS_URL=redis://localhost:6389
LOG_LEVEL=info
# Who is signed in. "dev" signs every request in as DEV_USER_ID and is refused in production.
# "jwt" verifies a bearer token with JWT_SECRET. Ensemble's own sign-in is another provider behind the same interface.
AUTH_PROVIDER=dev
DEV_USER_ID=usr_maya
# Email. "dev" keeps sent and received mail in the database instead of using a real service.
EMAIL_PROVIDER=dev
# A provider signs what it delivers to /api/inbound/email with this (HMAC-SHA256 of the body, hex, in x-signature).
EMAIL_INBOUND_SECRET=dev-inbound-secret-change-me
EMAIL_SWEEP_SECONDS=15
# Encrypts secrets the CRM stores (the assistant model key). At least 32 characters. Set your own in production.
CRM_SECRETS_KEY=dev-only-secrets-key-change-me-0123456789
