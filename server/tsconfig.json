{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["src", "test", "../src/lib/formula.ts", "../src/lib/rules.ts", "../src/contracts", "../src/mock/definitions.ts", "../src/mock/generate.ts", "../src/mock/team.ts", "../src/mock/reports.ts", "../src/mock/inbox.ts", "../src/mock/sequences.ts", "../src/mock/capture.ts"]
}
