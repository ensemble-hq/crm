{
  "name": "@ensemble-templates/crm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p server && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "dev:live": "vite --mode live --port 5185",
    "api": "cd server && tsx watch src/main.ts",
    "db:up": "docker compose up -d",
    "db:generate": "cd server && node ../../../mariachi/packages/cli/dist/index.js db generate --schema src/schema/index.ts --out drizzle",
    "db:migrate": "cd server && node ../../../mariachi/packages/cli/dist/index.js db migrate --schema src/schema/index.ts --out drizzle",
    "db:seed": "cd server && tsx src/seed.ts",
    "worker": "cd server && tsx watch src/worker.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "link:../../mariachi/packages/ai/node_modules/@ai-sdk/openai",
    "@fontsource-variable/inter": "^5.1.0",
    "@mariachi/ai": "link:../../mariachi/packages/ai",
    "@mariachi/api-facade": "link:../../mariachi/packages/api-facade",
    "@mariachi/audit": "link:../../mariachi/packages/audit",
    "@mariachi/auth": "link:../../mariachi/packages/auth",
    "@mariachi/communication": "link:../../mariachi/packages/communication",
    "@mariachi/config": "link:../../mariachi/packages/config",
    "@mariachi/core": "link:../../mariachi/packages/core",
    "@mariachi/database": "link:../../mariachi/packages/database",
    "@mariachi/database-postgres": "link:../../mariachi/packages/database-postgres",
    "@mariachi/design": "link:../../mariachi/packages/design",
    "@mariachi/encryption": "link:../../mariachi/packages/encryption",
    "@mariachi/events": "link:../../mariachi/packages/events",
    "@mariachi/lifecycle": "link:../../mariachi/packages/lifecycle",
    "@mariachi/rate-limit": "link:../../mariachi/packages/rate-limit",
    "@mariachi/realtime": "link:../../mariachi/packages/realtime",
    "@xyflow/react": "^12.12.1",
    "drizzle-orm": "link:../../mariachi/packages/database-postgres/node_modules/drizzle-orm",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "0.30.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
